# Required
OPENAI_API_KEY=your_api_key_here

# Current defaults; change these without editing code if your account uses different models.
OPENAI_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Retrieval / indexing
CHROMA_PATH=.chroma
CHROMA_COLLECTION=engineering_docs
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
TOP_K=5
